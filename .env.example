# Copy to .env and fill in your Azure OpenAI Foundry deployment details.
# .env is gitignored -- never commit real credentials.

AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-deployment-name>

# Optional: request native (Matryoshka) truncation to a smaller dimension.
# Only supported by text-embedding-3-small / text-embedding-3-large deployments.
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=1024
